---
import "@fontsource-variable/inter";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  active?: "home" | "kurs" | "konsulat" | "faq" | "ulotka" | "rejestracja" | "kontakt" | "impressum";
}

const {
  title = "Język polski do niemieckiej matury (Abitur) — Bawaria",
  description = "Kurs języka polskiego jako spät beginnende Fremdsprache dla uczniów z regionu Nürnberg–Fürth–Erlangen. Projekt informacyjny grupy rodziców z Norymbergi.",
  lang = "pl",
  active = "home",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='50' fill='%23ffffff'/%3E%3Crect y='50' width='100' height='50' fill='%238a1c2b'/%3E%3Crect width='100' height='100' fill='none' stroke='%23111418' stroke-width='4'/%3E%3C/svg%3E"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-paper focus:px-3 focus:py-2"
    >
      Przejdź do treści
    </a>

    <Header active={active} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

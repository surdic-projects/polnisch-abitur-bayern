---
import "@fontsource-variable/inter";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/600.css";
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { DEFAULT_LANG, LANGS, path, type Lang, type PageKey } from "~/i18n";
import { UI } from "~/i18n/ui";

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  description?: string;
}

const {
  lang,
  page,
  title = UI[lang].meta.title,
  description = UI[lang].meta.description,
} = Astro.props;

const absolute = (l: Lang) => new URL(path(l, page), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="canonical" href={absolute(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LANG)} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='50' fill='%23ffffff'/%3E%3Crect y='50' width='100' height='50' fill='%238a1c2b'/%3E%3Crect width='100' height='100' fill='none' stroke='%23111418' stroke-width='4'/%3E%3C/svg%3E"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-paper focus:px-3 focus:py-2"
    >
      {UI[lang].skipLink}
    </a>

    <Header lang={lang} page={page} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

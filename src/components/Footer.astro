---
import { withBase } from "~/lib/url";
import { CONTACT_EMAIL, CONTACT_MAILTO } from "~/data/contact";
import { path, type Lang } from "~/i18n";
import { NAV, UI } from "~/i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const ui = UI[lang];
const year = new Date().getFullYear();
const surdicLogo = withBase("/surdic-logo.svg");
---

<footer class="mt-24 border-t border-rule bg-paper-soft">
  <div class="container-content py-10 md:py-14">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="font-serif text-lg font-semibold">{ui.brand}</div>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed max-w-sm" set:html={ui.footer.about} />
      </div>

      <div>
        <div class="eyebrow">{ui.footer.navTitle}</div>
        <ul class="mt-3 space-y-1.5 text-sm">
          {NAV.map((key) => (
            <li><a href={path(lang, key)} class="link">{ui.footer.nav[key]}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <div class="eyebrow">{ui.footer.contactTitle}</div>
        <ul class="mt-3 space-y-2 text-sm text-ink-soft">
          <li>
            <a href={CONTACT_MAILTO} class="link break-all">
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            Instagram:
            <a href="https://www.instagram.com/polnisch_abi/" target="_blank" rel="noopener" class="link">
              @polnisch_abi
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-rule">
    <div class="container-content py-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-mute leading-relaxed">
        © {year} Anna Dębska-Kroener · {ui.footer.disclaimer}
      </p>
      <div class="flex items-center gap-4 shrink-0">
        <a
          href={path(lang, "impressum")}
          class="text-xs text-ink-mute hover:text-ink transition-colors"
        >
          {ui.footer.impressum}
        </a>
        <span aria-hidden="true" class="block h-3 w-px bg-rule"></span>
        <a
          href="https://surdic.com"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-ink-mute hover:text-ink transition-colors"
        >
          <img src={surdicLogo} alt="" width="12" height="13" class="h-3.5 w-auto" />
          <span class="text-xs">Surdic IT</span>
        </a>
      </div>
    </div>
  </div>
</footer>

---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { CONTACT_EMAIL, CONTACT_MAILTO } from "~/data/contact";
---

<BaseLayout
  active="kontakt"
  title="Kontakt — Język polski do Abitur — Bawaria"
>
  <section class="border-b border-rule">
    <div class="container-content pt-16 pb-14 md:pt-24 md:pb-16">
      <div class="kicker">Kontakt</div>
      <h1 class="mt-6 max-w-3xl">Napisz do nas</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
        Zapraszamy do kontaktu przez formularz kontaktowy lub bezpośrednio
        na adres e-mail.
      </p>
    </div>
  </section>

  <section class="container-content py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <aside class="md:col-span-4 space-y-8">
        <div>
          <div class="eyebrow">Adres e-mail</div>
          <a
            href={CONTACT_MAILTO}
            class="mt-3 block font-serif text-lg link break-all"
          >
            {CONTACT_EMAIL}
          </a>
        </div>

        <div>
          <div class="eyebrow">Region</div>
          <p class="mt-3 text-ink">Nürnberg · Fürth · Erlangen</p>
        </div>

        <div>
          <div class="eyebrow">Media społecznościowe</div>
          <ul class="mt-3 space-y-1.5 text-sm">
            <li>
              Instagram:
              <a
                href="https://www.instagram.com/polnisch_abi/"
                target="_blank"
                rel="noopener"
                class="link"
              >
                @polnisch_abi
              </a>
            </li>
            <li>
              Facebook:
              <span class="text-ink-mute">(w przygotowaniu)</span>
            </li>
          </ul>
        </div>
      </aside>

      <form
        class="md:col-span-8 border border-rule bg-paper-card p-6 md:p-8 space-y-5"
        method="post"
        action={CONTACT_MAILTO}
        enctype="text/plain"
      >
        <div>
          <label for="name" class="block text-sm font-medium">Imię i nazwisko</label>
          <input
            id="name"
            name="Imię"
            type="text"
            required
            autocomplete="name"
            class="mt-2 block w-full border border-rule bg-paper px-3 py-2.5 text-[0.95rem] focus:outline-none focus:border-ink"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium">Adres e-mail</label>
          <input
            id="email"
            name="E-mail"
            type="email"
            required
            autocomplete="email"
            class="mt-2 block w-full border border-rule bg-paper px-3 py-2.5 text-[0.95rem] focus:outline-none focus:border-ink"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium">Wiadomość</label>
          <textarea
            id="message"
            name="Wiadomość"
            rows="6"
            required
            class="mt-2 block w-full border border-rule bg-paper px-3 py-2.5 text-[0.95rem] focus:outline-none focus:border-ink resize-y"
          ></textarea>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
          <p class="text-xs text-ink-mute max-w-md">
            Formularz otwiera domyślnego klienta pocztowego z gotową treścią wiadomości.
            Alternatywnie prosimy o wysłanie e-maila bezpośrednio na podany adres.
          </p>
          <button type="submit" class="btn btn-primary">Wyślij wiadomość</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

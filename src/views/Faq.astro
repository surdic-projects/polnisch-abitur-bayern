---
import BaseLayout from "~/layouts/BaseLayout.astro";
import FaqItem from "~/components/FaqItem.astro";
import { FAQ, FAQ_AS_OF, FAQ_SOURCES } from "~/data/faq";
import { path, type Lang } from "~/i18n";
import { UI } from "~/i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const pl = {
  title: "Pytania i odpowiedzi — Język polski do Abitur — Bawaria",
  kicker: "Pytania i odpowiedzi",
  heading: "Najczęściej zadawane pytania",
  intro: `Informacje dotyczą planowanego wprowadzenia <strong class="text-ink">polskiego</strong>
    jako szkolnego przedmiotu <em>„spät beginnende Fremdsprache”</em> w bawarskim
    Gymnasium G9. Standardowa ścieżka obejmuje klasy 11–13. Istnieje możliwość
    dołączenia do kursu w klasie 12.`,
  contact: `Jeżeli nie znajdujesz tu odpowiedzi na swoje pytanie, napisz do nas przez
    <a href="${path("pl", "kontakt")}" class="link">formularz kontaktowy</a>.`,
  asOf: "Stan informacji:",
  sourcesTitle: "Źródła",
  sourcesIntro: `Odsyłacze w nawiasach kwadratowych prowadzą do źródeł poniżej. Przepisy GSO
    i BaySchFG sprawdzono w wersjach obowiązujących od 1 sierpnia 2026 r. Dane
    lokalne o uruchomieniu kursu wymagają osobnego potwierdzenia.`,
};

const de: typeof pl = {
  title: `Fragen und Antworten — ${UI.de.meta.titleSuffix}`,
  kicker: "Fragen und Antworten",
  heading: "Häufig gestellte Fragen",
  intro: `Die Informationen beziehen sich auf eine Einführung von
    <strong class="text-ink">Polnisch</strong> als schulischem Unterrichtsfach als
    <em>„spät beginnende Fremdsprache“</em> am bayerischen Gymnasium (G9). Der
    reguläre Bildungsweg umfasst die Jahrgangsstufen 11 bis 13. Es besteht die
    Möglichkeit, erst in Jahrgangsstufe 12 in den Kurs einzusteigen.`,
  contact: `Wenn Sie hier keine Antwort auf Ihre Frage finden, schreiben Sie uns über das
    <a href="${path("de", "kontakt")}" class="link">Kontaktformular</a>.`,
  asOf: "Stand der Informationen:",
  sourcesTitle: "Quellen",
  sourcesIntro: `Die Verweise in eckigen Klammern führen zu den nachfolgend aufgeführten
    Quellen. Die Bestimmungen der GSO und des BaySchFG wurden in den jeweils ab dem
    1. August 2026 geltenden Fassungen geprüft. Die lokalen Angaben zur Einrichtung
    des Kurses bedürfen einer gesonderten Bestätigung.`,
};

const t = { pl, de }[lang];
---

<BaseLayout lang={lang} page="faq" title={t.title}>
  <section class="border-b border-rule">
    <div class="container-content pt-16 pb-14 md:pt-24 md:pb-16">
      <div class="kicker">{t.kicker}</div>
      <h1 class="mt-6 max-w-3xl">{t.heading}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed" set:html={t.intro} />
      <p class="mt-4 max-w-2xl text-ink-soft leading-relaxed" set:html={t.contact} />
      <p class="mt-6 text-sm text-ink-mute">{t.asOf} {FAQ_AS_OF[lang]}</p>
    </div>
  </section>

  <section class="container-content py-14 md:py-20">
    <div class="max-w-3xl mx-auto">
      {FAQ[lang].map((item, i) => <FaqItem q={item.q} a={item.a} index={i} />)}
      <div class="border-t border-rule"></div>
    </div>
  </section>

  <section id="zrodla" class="border-t border-rule bg-paper-soft">
    <div class="container-content py-14 md:py-16">
      <div class="max-w-3xl mx-auto">
        <div class="kicker">{t.sourcesTitle}</div>
        <p class="mt-4 text-sm text-ink-soft leading-relaxed">{t.sourcesIntro}</p>
        <ol class="mt-6 space-y-2.5 text-sm">
          {FAQ_SOURCES.map((s) => (
            <li id={`zrodlo-${s.n}`} class="grid grid-cols-[2.5rem_1fr] gap-2 scroll-mt-6 target:bg-paper-card">
              <span class="tabular-nums text-ink-mute">[{s.n}]</span>
              <span class="text-ink-soft leading-relaxed">
                <span class="text-ink font-medium">{s.publisher[lang]}.</span>{" "}
                <a href={s.url} target="_blank" rel="noopener" class="link">{s.title[lang]}</a>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

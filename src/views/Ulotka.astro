---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { withBase } from "~/lib/url";
import { type Lang } from "~/i18n";
import { UI } from "~/i18n/ui";

interface Props { lang: Lang; }
const { lang } = Astro.props;

// The flyer itself is bilingual (PL/DE), so both languages share one file.
const flyerImgHref = withBase("/ulotka.png");
const flyerPdfHref = withBase("/ulotka.pdf");

const pl = {
  title: "Ulotka kursu — Język polski do Abitur — Bawaria",
  kicker: "Ulotka kursu",
  heading: "Podstawowe informacje — do wydruku i rozpowszechnienia",
  lead: `Jednostronicowa ulotka informacyjna o projekcie
    <em>„Polnisch als spät beginnende Fremdsprache für die Oberstufe in Nürnberg”</em>.
    Można ją pobrać, wydrukować i przekazać osobom, którym może być pomocna —
    w szkołach, w organizacjach polonijnych lub wśród znajomych.`,
  download: "Pobierz ulotkę (PDF)",
  openTab: "Otwórz w nowej karcie",
  openFull: "Otwórz pełnowymiarową wersję ulotki (PDF)",
  imgAlt: "Ulotka projektu: Polnisch als spät beginnende Fremdsprache für die Oberstufe in Nürnberg — informacje w języku polskim i niemieckim, adresowane do uczniów, którzy we wrześniu 2026 zaczynają 11. klasę.",
  caption: "Kliknij ulotkę, aby otworzyć wersję PDF do wydruku.",
  contentsTitle: "Co znajdziesz w ulotce",
  contents: [
    "Krótki opis projektu (PL / DE).",
    "Dla kogo: uczniowie, którzy we wrześniu 2026 zaczynają 11. klasę bawarskiego gimnazjum i mają polskie korzenie lub znają już język polski.",
    "Planowany kurs od 12. klasy (rok szkolny 2027/2028) — dodatkowe punkty do Abitur i rozwój znajomości języka polskiego.",
    "Kod QR z odnośnikiem do strony informacyjnej projektu.",
  ],
  usageTitle: "Jak z niej korzystać",
  usage: `Ulotkę można wydrukować w formacie A4 i przekazać w szkole, u nauczyciela
    języka polskiego lub w miejscach związanych z lokalnym środowiskiem polonijnym.
    Prosimy o rozpowszechnianie w oryginalnej postaci.`,
};

const de: typeof pl = {
  title: `Flyer — ${UI.de.meta.titleSuffix}`,
  kicker: "Flyer zum Kurs",
  heading: "Das Wichtigste – zum Ausdrucken und Weitergeben",
  lead: `Einseitiger Informationsflyer zum Projekt
    <em>„Polnisch als spät beginnende Fremdsprache für die Oberstufe in Nürnberg“</em>.
    Sie können ihn herunterladen, ausdrucken und an Menschen weitergeben, für die er
    hilfreich sein könnte – an Schulen, in polnischen Vereinen oder im Bekanntenkreis.`,
  download: "Flyer herunterladen (PDF)",
  openTab: "In neuem Tab öffnen",
  openFull: "Flyer in voller Größe öffnen (PDF)",
  imgAlt: "Flyer des Projekts: Polnisch als spät beginnende Fremdsprache für die Oberstufe in Nürnberg – Informationen auf Polnisch und Deutsch für Schülerinnen und Schüler, die im September 2026 in die 11. Klasse kommen.",
  caption: "Klicken Sie auf den Flyer, um die druckfähige PDF-Version zu öffnen.",
  contentsTitle: "Inhalt des Flyers",
  contents: [
    "Kurze Projektbeschreibung (PL / DE).",
    "Zielgruppe: Schülerinnen und Schüler, die im September 2026 in die 11. Klasse eines bayerischen Gymnasiums kommen und polnische Wurzeln haben oder bereits Polnisch sprechen.",
    "Geplanter Kurs ab Jahrgangsstufe 12 (Schuljahr 2027/2028) – zusätzliche Punkte fürs Abitur und bessere Polnischkenntnisse.",
    "QR-Code mit Link zur Informationsseite des Projekts.",
  ],
  usageTitle: "So nutzen Sie ihn",
  usage: `Der Flyer kann im A4-Format ausgedruckt und in der Schule, bei der
    Polnischlehrkraft oder an Orten der polnischen Community weitergegeben werden.
    Bitte verbreiten Sie ihn nur in der Originalfassung.`,
};

const t = { pl, de }[lang];
---

<BaseLayout lang={lang} page="ulotka" title={t.title}>
  <section class="border-b border-rule">
    <div class="container-content pt-16 pb-14 md:pt-24 md:pb-16">
      <div class="kicker">{t.kicker}</div>
      <h1 class="mt-6 max-w-4xl">{t.heading}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed" set:html={t.lead} />

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={flyerPdfHref} download class="btn btn-primary">
          {t.download}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3v12M6 11l6 6 6-6M4 21h16" />
          </svg>
        </a>
        <a href={flyerPdfHref} target="_blank" rel="noopener" class="btn btn-ghost">
          {t.openTab}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="container-content py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <figure class="md:col-span-8">
        <a
          href={flyerPdfHref}
          target="_blank"
          rel="noopener"
          class="block border border-rule bg-paper-card p-3 md:p-4 hover:border-ink transition-colors"
          aria-label={t.openFull}
        >
          <img
            src={flyerImgHref}
            alt={t.imgAlt}
            width="1748"
            height="2480"
            loading="lazy"
            class="block w-full h-auto"
          />
        </a>
        <figcaption class="mt-3 text-sm text-ink-mute">{t.caption}</figcaption>
      </figure>

      <aside class="md:col-span-4 md:pl-8 md:border-l md:border-rule">
        <div class="eyebrow">{t.contentsTitle}</div>
        <ul class="mt-4 space-y-3 text-sm text-ink-soft leading-relaxed list-disc pl-5">
          {t.contents.map((item) => <li>{item}</li>)}
        </ul>

        <div class="eyebrow mt-10">{t.usageTitle}</div>
        <p class="mt-3 text-sm text-ink-soft leading-relaxed">{t.usage}</p>
      </aside>
    </div>
  </section>
</BaseLayout>
